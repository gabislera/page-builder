DATABASE_URL="postgresql://builder:builder@localhost:5440/builder"

BETTER_AUTH_URL=http://localhost:3100
BETTER_AUTH_SECRET= # openssl rand -base64 32

S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=assets
S3_ACCESS_KEY=builder
S3_SECRET_KEY=builder-secret
S3_PUBLIC_URL=http://localhost:9100/assets

# IA (geração de seções). A chave só é lida no servidor.
OPENAI_API_KEY=
# Opcional: modelos e limite diário de gerações por usuário
# OPENAI_MODEL_FAST=gpt-5.4-mini
# OPENAI_MODEL_SMART=gpt-5.5
# AI_DAILY_LIMIT=150
